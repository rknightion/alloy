local.file "ssh_key" {
  filename  = "/etc/alloy/ssh/id_ed25519"
  is_secret = true
}

discovery.relabel "linux" {
  targets = [{"__address__" = "linux.example.com:22", "environment" = "lab"}]
}

prometheus.exporter.ssh "lab" {
  known_hosts_files   = ["/etc/alloy/ssh/known_hosts"]
  targets            = discovery.relabel.linux.output
  enabled_collectors = ["cpu", "loadavg", "meminfo", "stat", "uname"]

  auth "default" {
    username    = "metrics"
    private_key = local.file.ssh_key.content
  }
}

prometheus.scrape "lab" {
  targets         = prometheus.exporter.ssh.lab.targets
  forward_to      = []
  scrape_interval = "5s"

  clustering {
    enabled = true
  }
}
